{
  "family": "devfolio-backend",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::211026994178:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::211026994178:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "devfolio-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        },
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        },
        {
          "containerPort": 8443,
          "hostPort": 8443,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "APP_DEBUG", "value": "false" },
        { "name": "DB_CONNECTION", "value": "pgsql" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "REDIS_HOST", "value": "127.0.0.1" },
        { "name": "QUEUE_CONNECTION", "value": "redis" },
        { "name": "LOG_CHANNEL", "value": "stderr" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/devfolio-backend",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 6379,
          "hostPort": 6379,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/devfolio-backend",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "redis",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}
